# Forward-auth proxy providers for applications behind Traefik.
# All forward-auth providers must be listed here so the embedded outpost
# providers list (which is REPLACED, not merged) stays complete.
version: 1
metadata:
  labels:
    blueprints.goauthentik.io/instantiate: "true"
  name: Forward Auth Applications
entries:
  # ============================================================
  # Traefik Dashboard
  # ============================================================
  - model: authentik_providers_proxy.proxyprovider
    state: present
    id: provider-traefik-dashboard
    identifiers:
      name: Traefik Dashboard
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      mode: forward_single
      external_host: "https://{{ lookup('env', 'TF_VAR_domain') }}"

  - model: authentik_core.application
    state: present
    id: app-traefik-dashboard
    identifiers:
      slug: traefik-dashboard
    attrs:
      name: Traefik Dashboard
      provider: !KeyOf provider-traefik-dashboard
      meta_launch_url: "https://{{ lookup('env', 'TF_VAR_domain') }}/dashboard/"
      policy_engine_mode: any



  # ============================================================
  # Gatus (health dashboard) — internal tool, auth at the edge
  # ============================================================
  - model: authentik_providers_proxy.proxyprovider
    state: present
    id: provider-gatus-fwd
    identifiers:
      name: Gatus Forward Auth
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      mode: forward_single
      external_host: "https://gatus.{{ lookup('env', 'TF_VAR_domain') }}"

  - model: authentik_core.application
    state: present
    id: app-gatus-fwd
    identifiers:
      slug: gatus-forward-auth
    attrs:
      name: Gatus
      provider: !KeyOf provider-gatus-fwd
      meta_launch_url: "https://gatus.{{ lookup('env', 'TF_VAR_domain') }}/"
      policy_engine_mode: any

  # ============================================================
  # Homarr (dashboard) — internal tool, auth at the edge
  # ============================================================
  - model: authentik_providers_proxy.proxyprovider
    state: present
    id: provider-homarr-fwd
    identifiers:
      name: Homarr Forward Auth
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      mode: forward_single
      external_host: "https://dashboard.{{ lookup('env', 'TF_VAR_domain') }}"

  - model: authentik_core.application
    state: present
    id: app-homarr-fwd
    identifiers:
      slug: homarr-forward-auth
    attrs:
      name: Homarr (edge auth)
      provider: !KeyOf provider-homarr-fwd
      meta_launch_url: "https://dashboard.{{ lookup('env', 'TF_VAR_domain') }}/"
      policy_engine_mode: any

  # ============================================================
  # Tenancy groups (docs/PLAN.md H2.4)
  # 'internal' gates staff-only tools at the edge. Client access
  # is modeled as client-<name> groups bound per application.
  # ============================================================
  - model: authentik_core.group
    state: present
    id: group-internal
    identifiers:
      name: internal

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      order: 10
      target: !KeyOf app-traefik-dashboard
    attrs:
      group: !KeyOf group-internal

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      order: 10
      target: !KeyOf app-gatus-fwd
    attrs:
      group: !KeyOf group-internal

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      order: 10
      target: !KeyOf app-homarr-fwd
    attrs:
      group: !KeyOf group-internal

  # ============================================================
  # Embedded Outpost (all forward-auth providers)
  # ============================================================
  - model: authentik_outposts.outpost
    state: present
    identifiers:
      name: authentik Embedded Outpost
    attrs:
      type: proxy
      managed: goauthentik.io/outposts/embedded
      providers:
        - !Find [authentik_providers_proxy.proxyprovider, [name, "Traefik Dashboard"]]
        - !Find [authentik_providers_proxy.proxyprovider, [name, "Gatus Forward Auth"]]
        - !Find [authentik_providers_proxy.proxyprovider, [name, "Homarr Forward Auth"]]
      config:
        authentik_host: "https://auth.{{ lookup('env', 'TF_VAR_domain') }}"
