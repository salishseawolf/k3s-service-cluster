apiVersion: barmancloud.cnpg.io/v1
kind: ObjectStore
metadata:
  name: {{ postgres_cluster_name }}-store
  namespace: {{ postgres_namespace }}
spec:
  configuration:
    destinationPath: "s3://k3s-service-cluster/cnpg/"
    endpointURL: "https://s3.eu-central-003.backblazeb2.com"
    s3Credentials:
      accessKeyId:
        name: {{ postgres_backup_secret_name }}
        key: s3_key_id
      secretAccessKey:
        name: {{ postgres_backup_secret_name }}
        key: s3_application_key
    wal:
      compression: gzip
      maxParallel: 8
    data:
      compression: gzip

  instanceSidecarConfiguration:
    env:
      - name: AWS_REQUEST_CHECKSUM_CALCULATION
        value: "when_required"
      - name: AWS_RESPONSE_CHECKSUM_VALIDATION
        value: "when_required"
      - name: AWS_DEFAULT_REGION
        value: "eu-central-003"

  retentionPolicy: "{{ postgres_backup_retention }}"
