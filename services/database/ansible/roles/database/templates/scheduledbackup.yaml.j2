apiVersion: postgresql.cnpg.io/v1
kind: ScheduledBackup
metadata:
  name: daily-backup
  namespace: {{ postgres_namespace }}
spec:
  schedule: "0 0 0 * * *"
  backupOwnerReference: self
  immediate: false
  method: plugin
  pluginConfiguration:
    name: barman-cloud.cloudnative-pg.io
  cluster:
    name: {{ postgres_cluster_name }}
