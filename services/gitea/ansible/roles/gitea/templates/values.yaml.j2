global:
  storageClass: "{{ gitea_storage_class }}"

replicaCount: 1

# Disable built-in dependencies — using external CloudNativePG and Redis
postgresql-ha:
  enabled: false

valkey-cluster:
  enabled: false

image:
  registry: "{{ gitea_image.registry }}"
  repository: "{{ gitea_image.repository }}"
  tag: "{{ gitea_image.tag | default(omit) }}"
  rootless: {{ gitea_image.rootless | string | lower }}

persistence:
  create: true
  size: "{{ gitea_storage_size }}"
  claimName: gitea-data

service:
  ssh:
    clusterIP: ""  # Override headless default — Traefik TCP routing fails with headless + named ports (Traefik#11041)

ingress:
  enabled: false

extraVolumes:
  - name: gitea-oidc-creds
    secret:
      secretName: gitea-oidc-creds
  - name: gitea-secrets
    secret:
      secretName: "{{ gitea_secrets_secret_name }}"

extraVolumeMounts:
  - name: gitea-oidc-creds
    mountPath: /etc/gitea/oidc
    readOnly: true
  - name: gitea-secrets
    mountPath: /etc/gitea/secrets
    readOnly: true

resources:
  requests:
    cpu: "{{ gitea_resources_requests_cpu }}"
    memory: "{{ gitea_resources_requests_memory }}"
  limits:
    cpu: "{{ gitea_resources_limits_cpu }}"
    memory: "{{ gitea_resources_limits_memory }}"

podSecurityContext:
  fsGroup: 1000
  fsGroupChangePolicy: Always

containerSecurityContext:
  allowPrivilegeEscalation: false
  capabilities:
    drop:
      - ALL
  runAsNonRoot: true
  seccompProfile:
    type: RuntimeDefault

statefulset:
  env:
    - name: GITEA_APP_INI
      value: /data/gitea/conf/app.ini
    - name: GITEA_CUSTOM
      value: /data/gitea
    - name: GITEA_WORK_DIR
      value: /data
    - name: GITEA_TEMP
      value: /tmp/gitea

gitea:
  config:
    server:
      DOMAIN: "{{ gitea_domain }}"
      ROOT_URL: "https://{{ gitea_domain }}"
      SSH_PORT: 2222
      SSH_LISTEN_PORT: 2222
      SSH_DOMAIN: "{{ gitea_domain }}"
      OFFLINE_MODE: false
      LANDING_PAGE: login
      ENABLE_ACCESS_LOG: true
    database:
      DB_TYPE: postgres
      HOST: main-db-rw.database.svc.cluster.local:5432
      NAME: "{{ gitea_db_name }}"
      USER: "{{ gitea_db_user }}"
      PASSWD: "{{ lookup('env', 'GITEA_DB_PASSWORD') }}"
      SSL_MODE: disable
    security:
      DISABLE_GIT_HOOKS: false
      INSTALL_LOCK: true
      SECRET_KEY: "${GITEA__security__SECRET_KEY}"
      INTERNAL_TOKEN: "${GITEA__security__INTERNAL_TOKEN}"
      PASSWORD_COMPLEXITY: "lower,upper,digit"
      MIN_PASSWORD_LENGTH: 12
      PASSWORD_HASH_ALGO: argon2
    session:
      PROVIDER: redis
      PROVIDER_CONFIG: "{{ gitea_redis_url }}/0"
    cache:
      ADAPTER: redis
      HOST: "{{ gitea_redis_url }}"
    queue:
      TYPE: redis
      CONN_STR: "{{ gitea_redis_url }}/1"
    storage:
      STORAGE_TYPE: local
    oauth2_client:
      REGISTER_EMAIL_CONFIRM: false
      ENABLE_AUTO_REGISTRATION: true
      OPENID_CONNECT_SCOPES: "openid profile email"
    oauth2:
      JWT_SECRET: "${GITEA__oauth2__JWT_SECRET}"
    log:
      LEVEL: info
      ROOT_PATH: /data/gitea/log
      MODE: console, file
    log.file:
      FILE_NAME: gitea.log
      LOG_ROTATE: true
      MAX_DAYS: 90
      MAX_SIZE_SHIFT: 28
    openid:
      ENABLE_OPENID_SIGNIN: false
    service:
      DISABLE_REGISTRATION: true
      ENABLE_PASSWORD_SIGNIN_FORM: false
    mailer:
      ENABLED: true
      PROTOCOL: smtps
      SMTP_ADDR: "{{ lookup('env', 'GITEA_SMTP_HOST') }}"
      SMTP_PORT: "{{ lookup('env', 'GITEA_SMTP_PORT') }}"
      USER: "{{ lookup('env', 'GITEA_SMTP_USERNAME') }}"
      PASSWD: "{{ lookup('env', 'GITEA_SMTP_PASSWORD') }}"
      FROM: "Gitea <gitea@{{ lookup('env', 'TF_VAR_domain') }}>"
    repository:
      DEFAULT_BRANCH: main
      FORCE_PRIVATE: true
      ENABLE_PUSH_CREATE_USER: true
      ENABLE_PUSH_CREATE_ORG: true
      DEFAULT_REPO_UNITS: "repo.code,repo.releases,repo.issues,repo.pulls,repo.wiki,repo.projects,repo.packages,repo.actions"
    repository.pull-request:
      DEFAULT_MERGE_STYLE: rebase
      DEFAULT_DELETE_BRANCH_AFTER_MERGE: true
    actions:
      DEFAULT_ACTIONS_URL: self
      LOG_RETENTION_DAYS: 30
      ARTIFACT_RETENTION_DAYS: 14
      ZOMBIE_TASK_TIMEOUT: 15m
      ABANDONED_JOB_TIMEOUT: 1h
    indexer:
      REPO_INDEXER_ENABLED: true
      REPO_INDEXER_TYPE: bleve
      REPO_INDEXER_PATH: indexers/repos.bleve
      MAX_FILE_SIZE: 1048576
    api:
      ENABLE_SWAGGER: true
      ENABLE_API_LIMITS: true
      MAX_RESPONSE_ITEMS: 50
    webhook:
      DELIVER_TIMEOUT: 30
      QUEUE_LENGTH: 100
    metrics:
      ENABLED: true
      ENABLE_ISSUE_BY_LABEL: true
      ENABLE_ISSUE_BY_REPOSITORY: true
    packages:
      ENABLED: true
      CHUNKED_UPLOAD_PATH: "/data/gitea/packages"

  extraEnv:
    - name: GITEA__database__PASSWD
      valueFrom:
        secretKeyRef:
          key: password
          name: gitea-secrets
    - name: GITEA__security__INTERNAL_TOKEN
      valueFrom:
        secretKeyRef:
          key: internal_token
          name: gitea-secrets
    - name: GITEA__security__SECRET_KEY
      valueFrom:
        secretKeyRef:
          key: secret_key
          name: gitea-secrets
    - name: GITEA__oauth2__JWT_SECRET
      value: "{{ gitea_jwt_secret }}"
    - name: GITEA__oauth__key
      valueFrom:
        secretKeyRef:
          key: client_id
          name: gitea-oidc-creds
    - name: GITEA__oauth__secret
      valueFrom:
        secretKeyRef:
          key: client_secret
          name: gitea-oidc-creds

  admin:
    username: gitea_admin
    password: "{{ lookup('env', 'GITEA_DB_PASSWORD') }}"
    email: gitea@{{ lookup('env', 'TF_VAR_domain') }}
