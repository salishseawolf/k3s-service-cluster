---
version: 1
metadata:
  name: Gatus
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:
  - model: authentik_providers_oauth2.oauth2provider
    state: present
    id: gatus-provider
    identifiers:
      name: Gatus
    attrs:
      client_type: confidential
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      redirect_uris:
        - matching_mode: strict
          url: "https://{{ gatus_domain }}/authorization-code/callback"
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      sub_mode: hashed_user_id
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-invalidation-flow]]
      access_code_validity: minutes=5
      access_token_validity: hours=24
      grant_types:
        - authorization_code
        - refresh_token
      include_claims_in_id_token: true
      property_mappings:
        - !Find [authentik_core.propertymapping, [name, "authentik default OAuth Mapping: OpenID 'openid'"]]
        - !Find [authentik_core.propertymapping, [name, "authentik default OAuth Mapping: OpenID 'profile'"]]
        - !Find [authentik_core.propertymapping, [name, "authentik default OAuth Mapping: OpenID 'email'"]]
      scope_set:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]

  - model: authentik_core.application
    state: present
    identifiers:
      name: Gatus
      slug: {{ gatus_authentik_slug }}
    attrs:
      group: Services
      provider: !KeyOf gatus-provider
      meta_launch_url: "https://{{ gatus_domain }}"
      meta_description: Service health monitoring dashboard
