---
# Gatus Helm values — PodSecurity "restricted" compliant

image:
  repository: {{ gatus_image }}
  tag: "v5.34.0"

# Pod Security Context (restricted policy)
podSecurityContext:
  runAsNonRoot: true
  runAsUser: 1000
  runAsGroup: 1000
  fsGroup: 1000
  seccompProfile:
    type: RuntimeDefault

# Container Security Context
securityContext:
  allowPrivilegeEscalation: false
  runAsNonRoot: true
  runAsUser: 1000
  capabilities:
    drop:
      - ALL

resources:
  requests:
    cpu: 50m
    memory: 64Mi
  limits:
    cpu: 200m
    memory: 256Mi

# Environment variables
env:
  OIDC_CLIENT_ID:
    valueFrom:
      secretKeyRef:
        name: "{{ gatus_oidc_secret_name }}"
        key: client_id
  OIDC_CLIENT_SECRET:
    valueFrom:
      secretKeyRef:
        name: "{{ gatus_oidc_secret_name }}"
        key: client_secret
  DATABASE_PASSWORD:
    valueFrom:
      secretKeyRef:
        name: gatus-db
        key: password
  GATUS_TEAMS_WEBHOOK:
    valueFrom:
      secretKeyRef:
        name: gatus-teams-webhook
        key: url

# Gatus configuration — endpoints, alerting, storage, UI, OIDC
config:
  storage:
    type: postgres
    path: >-
      postgres://{{ gatus_db_user }}:${DATABASE_PASSWORD}@{{ gatus_db_host }}:{{ gatus_db_port }}/{{ gatus_db_name }}?sslmode={{ gatus_db_sslmode }}
    retention: 720h

  connectivity:
    checker:
      target: "1.1.1.1:53"
      interval: 5m

  alerting:
    teams:
      webhook-url: "${GATUS_TEAMS_WEBHOOK}"

  endpoints:
    - name: Authentik
      group: services
      url: "https://auth.{{ lookup('env', 'TF_VAR_domain') }}/-/health/live/"
      interval: 60s
      conditions:
        - "[STATUS] == 200"
      failures: 3
      success: 2
    - name: Copyparty
      group: services
      url: "tcp://copyparty.copyparty.svc.cluster.local:3923"
      interval: 60s
      conditions:
        - "[CONNECTED] == true"
      failures: 3
      success: 2
    - name: K3s API
      group: platform
      url: "tcp://kubernetes.default.svc.cluster.local:443"
      interval: 30s
      conditions:
        - "[CONNECTED] == true"
      failures: 3
      success: 2
    - name: Traefik Dashboard
      group: platform
      url: "https://{{ lookup('env', 'TF_VAR_domain') }}/dashboard/"
      interval: 60s
      conditions:
        - "[STATUS] == 200"
      failures: 3
      success: 2
    - name: Wildcard TLS Certificate Expiry
      group: platform
      url: "https://auth.{{ lookup('env', 'TF_VAR_domain') }}/"
      interval: 120s
      conditions:
        - "[CERTIFICATE_EXPIRATION] > 168h"
    - name: Step-CA Health
      group: platform
      url: "tcp://step-ca.step-ca.svc.cluster.local:443"
      interval: 60s
      conditions:
        - "[CONNECTED] == true"
      failures: 3
      success: 2
    - name: CloudNativePG (Postgres)
      group: database
      url: "tcp://main-db-rw.database.svc.cluster.local:5432"
      interval: 60s
      conditions:
        - "[CONNECTED] == true"
      failures: 3
      success: 2
    - name: Redis
      group: database
      url: "tcp://redis.redis.svc.cluster.local:6379"
      interval: 60s
      conditions:
        - "[CONNECTED] == true"
      failures: 3
      success: 2
    - name: SeaweedFS S3 API
      group: storage
      url: "tcp://seaweedfs-s3.seaweedfs.svc.cluster.local:8333"
      interval: 60s
      conditions:
        - "[CONNECTED] == true"
      failures: 3
      success: 2
    - name: SeaweedFS Master
      group: storage
      url: "tcp://seaweedfs-internal.seaweedfs.svc.cluster.local:9333"
      interval: 60s
      conditions:
        - "[CONNECTED] == true"
      failures: 3
      success: 2
    - name: SeaweedFS Filer
      group: storage
      url: "tcp://seaweedfs-internal.seaweedfs.svc.cluster.local:8888"
      interval: 60s
      conditions:
        - "[CONNECTED] == true"
      failures: 3
      success: 2
    - name: SeaweedFS Volume
      group: storage
      url: "tcp://seaweedfs-internal.seaweedfs.svc.cluster.local:8080"
      interval: 60s
      conditions:
        - "[CONNECTED] == true"
      failures: 3
      success: 2
    - name: SeaweedFS CSI Controller
      group: storage
      url: "tcp://seaweedfs-csi-controller.seaweedfs-csi.svc.cluster.local:9808"
      interval: 60s
      conditions:
        - "[CONNECTED] == true"
      failures: 3
      success: 2
    - name: SeaweedFS Backup Freshness
      group: backups
      url: "http://seaweedfs-backup-check.seaweedfs.svc.cluster.local:8080/health"
      interval: 3600s
      conditions:
        - "[STATUS] == 200"
      failures: 3
      success: 2
    - name: Internet Connectivity
      group: external
      url: "https://google.com"
      interval: 300s
      timeout: 30s
      conditions:
        - "[STATUS] == 200"
        - "[RESPONSE_TIME] < 2000"
      failures: 3
      success: 2
    - name: Paperless-ngx
      group: services
      url: "https://paperless.{{ lookup('env', 'TF_VAR_domain') }}"
      interval: 60s
      conditions:
        - "[STATUS] == 200"
      failures: 3
      success: 2
    - name: Homarr
      group: services
      url: "tcp://homarr.homarr.svc.cluster.local:7575"
      interval: 60s
      conditions:
        - "[CONNECTED] == true"
      failures: 3
      success: 2
    - name: Gitea
      group: services
      url: "https://git.{{ lookup('env', 'TF_VAR_domain') }}/api/healthz"
      interval: 60s
      conditions:
        - "[STATUS] == 200"
      failures: 3
      success: 2
    - name: Gatus (self)
      group: internal
      # Internal endpoint: the public URL now sits behind forward-auth and
      # would 302 to Authentik, failing the check.
      url: "http://gatus.gatus.svc.cluster.local:8080/health"
      interval: 60s
      conditions:
        - "[STATUS] == 200"
      failures: 3
      success: 2

  ui:
    title: "Cluster Status — {{ lookup('env', 'TF_VAR_domain') }}"
    header: "K3s Service Cluster Health Dashboard"

  security:
    oidc:
      issuer-url: "{{ gatus_oidc_issuer_url }}"
      redirect-url: "https://{{ gatus_domain }}/authorization-code/callback"
      client-id: "${OIDC_CLIENT_ID}"
      client-secret: "${OIDC_CLIENT_SECRET}"
      scopes:
        - openid
        - email
        - profile

  metrics: true


# Disable the chart's built-in ingress — we use Traefik IngressRoute CR
ingress:
  enabled: false

service:
  port: 8080
