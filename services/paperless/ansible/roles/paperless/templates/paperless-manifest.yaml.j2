apiVersion: apps/v1
kind: Deployment
metadata:
  name: paperless
  namespace: {{ paperless_namespace }}
  labels:
    app: paperless
spec:
  replicas: 1
  selector:
    matchLabels:
      app: paperless
  template:
    metadata:
      labels:
        app: paperless
    spec:
      initContainers:
        - name: fix-perms
          image: "{{ paperless_image }}:{{ paperless_image_tag }}"
          imagePullPolicy: Always
          command:
            - sh
            - -c
            - |
              chmod 0777 /run
          securityContext:
            runAsUser: 0
          volumeMounts:
            - name: run
              mountPath: /run
      securityContext:
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        fsGroupChangePolicy: OnRootMismatch
      containers:
        - name: paperless
          image: "{{ paperless_image }}:{{ paperless_image_tag }}"
          imagePullPolicy: Always
          env:
            - name: PAPERLESS_URL
              value: "https://{{ paperless_domain }}"
            - name: REDIS_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: redis-credentials
                  key: password
            - name: PAPERLESS_REDIS
              value: "redis://:$(REDIS_PASSWORD)@{{ paperless_redis_host }}:{{ paperless_redis_port }}"
            - name: PAPERLESS_DBHOST
              value: "{{ paperless_db_host }}"
            - name: PAPERLESS_DBPORT
              value: "{{ paperless_db_port }}"
            - name: PAPERLESS_DBNAME
              value: "{{ paperless_db_name }}"
            - name: PAPERLESS_DBUSER
              value: "{{ paperless_db_user }}"
            - name: PAPERLESS_DBPASS
              valueFrom:
                secretKeyRef:
                  name: "{{ paperless_secrets_secret_name }}-db"
                  key: password
            - name: PAPERLESS_DBSSLMODE
              value: disable
            - name: PAPERLESS_SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: "{{ paperless_secrets_secret_name }}"
                  key: secret_key
            - name: PAPERLESS_CONSUMER_DISABLE
              value: "true"
            - name: PAPERLESS_LOGROTATE_MAX_SIZE
              value: "10485760"
            - name: PAPERLESS_TIME_ZONE
              value: America/Denver
            - name: PAPERLESS_DISABLE_REGULAR_LOGIN
              value: "true"
            - name: PAPERLESS_REDIRECT_LOGIN_TO_SSO
              value: "true"
            - name: PAPERLESS_CSRF_TRUSTED_ORIGINS
              value: "https://{{ paperless_domain }}"
            - name: PAPERLESS_APPS
              value: allauth.socialaccount.providers.openid_connect
            - name: PAPERLESS_SOCIAL_AUTO_SIGNUP
              value: "true"
            - name: PAPERLESS_SOCIAL_ACCOUNT_SYNC_GROUPS
              value: "true"
            - name: PAPERLESS_SOCIAL_ACCOUNT_DEFAULT_GROUPS
              value: infrastructure
            - name: PAPERLESS_SOCIALACCOUNT_ALLOW_SIGNUPS
              value: "true"
            - name: PAPERLESS_AUDIT_LOG_ENABLED
              value: "true"
            - name: PAPERLESS_EMAIL_HOST
              value: "smtp.resend.com"
            - name: PAPERLESS_EMAIL_PORT
              value: "2465"
            - name: PAPERLESS_EMAIL_HOST_USER
              value: "resend"
            - name: PAPERLESS_EMAIL_HOST_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: "{{ paperless_secrets_secret_name }}-smtp"
                  key: password
            - name: PAPERLESS_EMAIL_USE_TLS
              value: "true"
            - name: PAPERLESS_LOGOUT_REDIRECT_URL
              value: "{{ paperless_authentik_host }}/application/o/{{ paperless_authentik_slug }}/end-session/"
            - name: PAPERLESS_SOCIALACCOUNT_PROVIDERS
              valueFrom:
                secretKeyRef:
                  name: "{{ paperless_oidc_creds_secret_name }}"
                  key: socialaccount_providers
            - name: S6_YES_I_WANT_A_WORLD_WRITABLE_RUN_BECAUSE_KUBERNETES
              value: "1"
            - name: PAPERLESS_PORT
              value: "8000"
            - name: PAPERLESS_TIKA_ENABLED
              value: "true"
            - name: PAPERLESS_TIKA_ENDPOINT
              value: "http://tika.{{ paperless_namespace }}.svc.cluster.local:9998"
            - name: PAPERLESS_TIKA_GOTENBERG_ENDPOINT
              value: "http://gotenberg.{{ paperless_namespace }}.svc.cluster.local:3000"
          ports:
            - name: http
              containerPort: 8000
              protocol: TCP
          startupProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 120
            periodSeconds: 10
            failureThreshold: 30
          livenessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 60
            periodSeconds: 30
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 30
            periodSeconds: 10
            failureThreshold: 6
          resources:
            requests:
              cpu: "{{ paperless_resources_requests_cpu }}"
              memory: "{{ paperless_resources_requests_memory }}"
            limits:
              cpu: "{{ paperless_resources_limits_cpu }}"
              memory: "{{ paperless_resources_limits_memory }}"
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
            readOnlyRootFilesystem: false
            runAsNonRoot: true
          volumeMounts:
            - name: run
              mountPath: /run
            - name: data
              mountPath: /usr/src/paperless/data
            - name: media
              mountPath: /usr/src/paperless/media
      volumes:
        - name: run
          emptyDir:
            medium: Memory
        - name: data
          persistentVolumeClaim:
            claimName: paperless-data
        - name: media
          persistentVolumeClaim:
            claimName: paperless-media
---
apiVersion: v1
kind: Service
metadata:
  name: paperless
  namespace: {{ paperless_namespace }}
  labels:
    app: paperless
spec:
  ports:
    - name: http
      port: 80
      targetPort: 8000
      protocol: TCP
  selector:
    app: paperless
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: paperless
  namespace: {{ paperless_namespace }}
spec:
  entryPoints:
    - websecure
  routes:
    - match: "Host(`{{ paperless_domain }}`)"
      kind: Rule
      services:
        - name: paperless
          port: 80
  tls:
    secretName: wildcard-{{ lookup('env', 'TF_VAR_domain') | replace('.', '-') }}-tls
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: tika
  namespace: {{ paperless_namespace }}
  labels:
    app: tika
spec:
  replicas: 1
  selector:
    matchLabels:
      app: tika
  template:
    metadata:
      labels:
        app: tika
    spec:
      containers:
        - name: tika
          image: docker.io/apache/tika:latest
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 9998
              protocol: TCP
          startupProbe:
            tcpSocket:
              port: 9998
            initialDelaySeconds: 60
            periodSeconds: 10
            failureThreshold: 12
          livenessProbe:
            tcpSocket:
              port: 9998
            periodSeconds: 30
            failureThreshold: 3
          readinessProbe:
            tcpSocket:
              port: 9998
            periodSeconds: 10
            failureThreshold: 3
          resources:
            requests:
              cpu: 250m
              memory: 512Mi
            limits:
              cpu: 1000m
              memory: 2Gi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
            runAsUser: 1000
---
apiVersion: v1
kind: Service
metadata:
  name: tika
  namespace: {{ paperless_namespace }}
  labels:
    app: tika
spec:
  ports:
    - name: http
      port: 9998
      targetPort: 9998
      protocol: TCP
  selector:
    app: tika
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: gotenberg
  namespace: {{ paperless_namespace }}
  labels:
    app: gotenberg
spec:
  replicas: 1
  selector:
    matchLabels:
      app: gotenberg
  template:
    metadata:
      labels:
        app: gotenberg
    spec:
      containers:
        - name: gotenberg
          image: gotenberg/gotenberg:8
          imagePullPolicy: IfNotPresent
          command:
            - gotenberg
          args:
            - --chromium-disable-javascript=true
            - --chromium-allow-list=file:///tmp/.*
          ports:
            - name: http
              containerPort: 3000
              protocol: TCP
          startupProbe:
            httpGet:
              path: /health
              port: 3000
            initialDelaySeconds: 30
            periodSeconds: 5
            failureThreshold: 12
          livenessProbe:
            httpGet:
              path: /health
              port: 3000
            periodSeconds: 30
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /health
              port: 3000
            periodSeconds: 10
            failureThreshold: 3
          resources:
            requests:
              cpu: 250m
              memory: 256Mi
            limits:
              cpu: 500m
              memory: 512Mi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
            runAsUser: 1001
          volumeMounts:
            - name: gotenberg-cache
              mountPath: /home/gotenberg
      volumes:
        - name: gotenberg-cache
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: gotenberg
  namespace: {{ paperless_namespace }}
  labels:
    app: gotenberg
spec:
  ports:
    - name: http
      port: 3000
      targetPort: 3000
      protocol: TCP
  selector:
    app: gotenberg
