---
version: 1
metadata:
  name: Copyparty Filer
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:
  - model: authentik_providers_proxy.proxyprovider
    state: present
    id: provider-copyparty
    identifiers:
      name: Copyparty Filer
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      mode: forward_single
      external_host: "https://files.{{ copyparty_domain }}"
      access_token_validity: hours=24

  - model: authentik_core.application
    state: present
    id: app-copyparty
    identifiers:
      slug: copyparty
    attrs:
      name: Copyparty
      provider: !KeyOf provider-copyparty
      meta_launch_url: "https://files.{{ copyparty_domain }}"
      meta_description: "File sharing and storage"
      meta_icon: ""
      policy_engine_mode: any
      group: "Storage"

  - model: authentik_outposts.outpost
    state: present
    id: outpost-copyparty
    identifiers:
      name: Copyparty Filer Outpost
    attrs:
      type: proxy
      providers:
        - !KeyOf provider-copyparty
      config:
        authentik_host: http://authentik-server.identity.svc.cluster.local
        authentik_host_browser: "https://auth.{{ lookup('env', 'TF_VAR_domain') }}"
