// Renovate config. Scope: every services/*/app chart (images in templates and
// values, chart dependencies), plus the monitoring-crd platform app so its CRDs
// move in lockstep with kube-prometheus-stack in services/monitoring.
// Widen by editing enabledManagers / includePaths / managerFilePatterns.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  timezone: "America/Los_Angeles",
  // New updates start only in 05:00-05:59 Pacific (Renovate checks the hour;
  // minutes must be "*"). The CronJob runs hourly, so between windows it still
  // opens PRs once CI passes, rebases, and acts on dashboard clicks.
  schedule: ["* 5 * * *"],

  // Merged == deployed: let a release age 3 days before proposing it, so
  // broken or compromised releases are usually pulled or patched first.
  minimumReleaseAge: "3 days",
  // Only where the registry reports a release date. Docker Hub does; ghcr.io
  // images (homarr) don't, and the default (timestamp-required) would hold
  // those updates forever, so they get no delay.
  minimumReleaseAgeBehaviour: "timestamp-optional",
  dependencyDashboard: true,

  // GitHub App bot identity (an app cannot look itself up via /user).
  // 338865941 = id of the salishseawolf-renovate[bot] user, looked up with
  // (no auth needed; %5B/%5D are the URL-encoded brackets):
  //   curl -s https://api.github.com/users/salishseawolf-renovate%5Bbot%5D | jq .id
  // If the app is renamed or recreated, rerun with the new slug and update
  // both the id and the name below.
  gitAuthor: "salishseawolf-renovate[bot] <338865941+salishseawolf-renovate[bot]@users.noreply.github.com>",

  // Personal GitHub account: no branch protection, so Renovate is the gate.
  // A PR is only opened once validate-services passes on the renovate/**
  // branch, and nothing merges itself (merged == deployed via Argo).
  prCreation: "status-success",
  automerge: false,
  // No hourly cap (default 2): every branch whose CI passed gets its PR in
  // the same run. prConcurrentLimit stays at the default 10 open PRs.
  prHourlyLimit: 0,

  enabledManagers: ["kubernetes", "helm-values", "helmv3", "argocd"],
  includePaths: [
    "services/*/app/**",
    "platform/monitoring-crd/**",
    "platform/argocd/root/apps/monitoring-crd.yaml",
  ],
  kubernetes: {
    // images live in raw templates; the kubernetes manager has no default
    // file patterns
    managerFilePatterns: ["/^services/[^/]+/app/templates/.+\\.yaml$/"],
  },
  // helm-values (values.yaml images) and helmv3 (Chart.yaml dependencies) use
  // their default file patterns.
  helmv3: {
    // gitea, identity and umami vendor their subchart .tgz next to Chart.lock;
    // without this a bump would update the lock but leave the old archive.
    postUpdateOptions: ["helmUpdateSubChartArchives"],
  },
  argocd: {
    // Only the monitoring-crd app pulls a chart straight from a Helm repo
    // that we manage here; the rest of platform/ is not in scope yet.
    managerFilePatterns: ["/^platform/argocd/root/apps/monitoring-crd\\.yaml$/"],
  },

  packageRules: [
    {
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      // Tagged with a git SHA by its own build; nothing for Renovate to compare.
      matchPackageNames: ["ghcr.io/mightbeawolf/personal-site"],
      enabled: false,
    },
    {
      // Renovate releases almost daily; take its own updates once a week.
      matchPackageNames: ["ghcr.io/renovatebot/renovate"],
      schedule: ["* 5 * * 1"],
    },
    {
      // CRDs (platform/monitoring-crd, wave 0) and workloads
      // (services/monitoring) must stay on the same chart version.
      matchPackageNames: ["kube-prometheus-stack"],
      groupName: "kube-prometheus-stack",
    },
    {
      matchPackageNames: ["busybox", "docker.io/library/busybox"],
      groupName: "busybox",
    },
  ],
}
