// Renovate config. Initial scope is Homarr only (services/homarr/app);
// widen by editing enabledManagers / includePaths / managerFilePatterns.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  timezone: "America/Los_Angeles",
  // New updates start only in 05:00-05:59 Pacific (Renovate checks the hour;
  // minutes must be "*"). The CronJob runs hourly, so between windows it still
  // opens PRs once CI passes, rebases, and acts on dashboard clicks.
  schedule: ["* 5 * * *"],

  // Merged == deployed: let a release age 3 days before proposing it, so
  // broken or compromised releases are usually pulled or patched first.
  minimumReleaseAge: "3 days",
  // Only where the registry reports a release date. Docker Hub does; ghcr.io
  // images (homarr) don't, and the default (timestamp-required) would hold
  // those updates forever, so they get no delay.
  minimumReleaseAgeBehaviour: "timestamp-optional",
  dependencyDashboard: true,

  // GitHub App bot identity (an app cannot look itself up via /user).
  // 338865941 = id of the salishseawolf-renovate[bot] user, looked up with
  // (no auth needed; %5B/%5D are the URL-encoded brackets):
  //   curl -s https://api.github.com/users/salishseawolf-renovate%5Bbot%5D | jq .id
  // If the app is renamed or recreated, rerun with the new slug and update
  // both the id and the name below.
  gitAuthor: "salishseawolf-renovate[bot] <338865941+salishseawolf-renovate[bot]@users.noreply.github.com>",

  // Personal GitHub account: no branch protection, so Renovate is the gate.
  // A PR is only opened once validate-services passes on the renovate/**
  // branch, and nothing merges itself (merged == deployed via Argo).
  prCreation: "status-success",
  automerge: false,

  enabledManagers: ["kubernetes"],
  includePaths: ["services/homarr/app/**"],
  kubernetes: {
    // images live in raw templates; the kubernetes manager has no default
    // file patterns
    managerFilePatterns: ["/^services/homarr/app/templates/.+\\.yaml$/"],
  },

  packageRules: [
    {
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
  ],
}
